# Gemini auth — pick ONE mode.

# Mode 1: API key (Google AI Studio)
GEMINI_API_KEY=your-api-key
# Model must exist on the Generative Language v1 API in key mode.
GEMINI_MODEL=gemini-3.5-flash

# Mode 2: Vertex AI with Application Default Credentials (preferred per AGENTS.md)
# Run `gcloud auth application-default login` first.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=genaihack26ath-52
# GOOGLE_CLOUD_LOCATION=global
# GEMINI_MODEL=gemini-3-flash-preview

# Server
PORT=8787
