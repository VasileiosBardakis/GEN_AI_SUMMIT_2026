{
  "name": "gen-ai-summit-2026",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "smoke": "playwright test --pass-with-no-tests",
    "check": "pnpm run build:extension && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run smoke",
    "build:extension": "pnpm --filter @gen/extension build",
    "dev": "node scripts/dev.mjs",
    "dev:build": "node extension/build.mjs",
    "dev:watch": "node scripts/watch-extension.mjs",
    "dev:browser": "node scripts/dev-browser.mjs",
    "dev:demo": "node scripts/dev-static.mjs",
    "dev:tail": "node scripts/tail-traces.mjs",
    "probe": "node --experimental-strip-types scripts/run-watcher-probe.mjs",
    "clean": "node scripts/clean.mjs",
    "server": "pnpm --filter @gen/server --stream start",
    "flow:simulate": "node scripts/simulate-flow.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  },
  "dependencies": {
    "dotenv": "^18.0.10"
  }
}
