{
  "name": "gen-ai-summit-2026",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "extension",
    "apps"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "smoke": "playwright test --pass-with-no-tests",
    "check": "npm run lint && npm run typecheck && npm run test && npm run smoke",
    "server": "npm run start -w @gen/server"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  }
}
