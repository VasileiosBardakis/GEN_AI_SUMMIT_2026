{
  "manifest_version": 3,
  "name": "Hands",
  "version": "0.0.1",
  "description": "Generic browser action executor.",
  "permissions": ["activeTab", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Run Hands demo plan"
  }
}
