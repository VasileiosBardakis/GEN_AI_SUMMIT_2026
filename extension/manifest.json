{
  "manifest_version": 3,
  "name": "Automation Ladder — Eyes Watcher",
  "version": "0.1.0",
  "description": "Local-first workflow sensor: captures all browser, grid, shortcut, and clipboard events with Layer-1 PII redaction.",
  "permissions": ["storage", "tabs", "sidePanel", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dist/replay-demo.webm"],
      "matches": ["<all_urls>"]
    }
  ],
  "side_panel": {
    "default_path": "dist/panel.html"
  },
  "action": {
    "default_title": "Open Eyes"
  }
}
